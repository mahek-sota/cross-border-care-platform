# Copy to infra/.env before running docker compose.

# --- Postgres ---
POSTGRES_USER=cbcare
POSTGRES_PASSWORD=cbcare
POSTGRES_DB=cbcare
# Host ports. Override any that collide with something already running locally.
POSTGRES_PORT=5432

# --- Host-side connection strings ---
# Used when you run alembic / pytest / scripts from your own shell rather than
# inside a container. docker compose overrides both for the api and worker services.
DATABASE_URL=postgresql+psycopg://cbcare:cbcare@localhost:5432/cbcare
TEST_DATABASE_URL=postgresql+psycopg://cbcare:cbcare@localhost:5432/cbcare_test

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-key-replace-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- S3 / MinIO ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cbcare-documents
S3_REGION=us-east-1

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
WEB_PORT=5173

# --- App ---
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173
